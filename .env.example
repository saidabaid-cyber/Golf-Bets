# The Backyard Account + Polla Live (Supabase). La app funciona como invitado sin estas variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alias moderno opcional; no es necesario cambiar las variables legacy actuales.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Nunca usar NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Feature flags de servidor. Nube/social conservan su valor predeterminado.
# Polla Live conserva un release lock en código; esta variable sola no lo activa.
CLOUD_ENABLED=
# Fail-closed. Enable only in Preview/Beta after applying the additive
# equipment migration to an isolated Beta database and verifying its RLS.
EQUIPMENT_CLOUD_ENABLED=
POLLA_LIVE_ENABLED=
AUTH_SOCIAL_ENABLED=

# Reglas con IA. La evidencia se recupera del índice local; OpenAI es el proveedor predeterminado.
RULES_AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_RULES_MODEL=
RULES_AI_ENABLED=

# Proveedor opcional: RULES_AI_PROVIDER=gemini. El vector store se conserva solo para el script legacy de indexado.
OPENAI_API_KEY=
OPENAI_RULES_VECTOR_STORE_ID=
OPENAI_RULES_MODEL=

# Backyard AI round setup + scorecard vision. Server-only and fail-closed when disabled.
# Readiness also requires NEXT_PUBLIC_SUPABASE_URL plus a server Supabase key
# because the distributed usage limiter is mandatory for every provider call.
# Authenticated text/image processing additionally requires the dedicated
# ai_processing_consents migration in the Supabase environment used by Preview.
# Server-only Preview binding: exact isolated NEXT_PUBLIC_SUPABASE_URL value.
# Leave unset until Preview no longer points at the Supabase shared by Production.
BACKYARD_AI_CONSENT_PREVIEW_SUPABASE_URL=
BACKYARD_AI_ENABLED=false
OPENAI_BACKYARD_MODEL=
OPENAI_SCORECARD_MODEL=

# Destructive QA is fail-closed: bind this to a NEW isolated Supabase project.
# Set only on Vercel Preview, branch phase2/full-platform. Never the shared DB.
PREVIEW_DB_REF=
ACCOUNT_LIFECYCLE_ENABLED=false
# Social uses an additional explicit activation and the same isolated project ref.
SOCIAL_ACTIVITY_ENABLED=false
SOCIAL_PREVIEW_DB_REF=

# GHIN read-only POC. Configure ONLY on an isolated Vercel Preview deployment.
# The existing public flag contains no credential; every network capability also
# requires its own server-only, fail-closed switch below.
NEXT_PUBLIC_BACKYARD_GHIN_INTEGRATION=false
GHIN_GOLFER_LOOKUP_ENABLED=false
GHIN_COURSE_LOOKUP_ENABLED=false
GHIN_COURSE_SYNC_ENABLED=false

# Server-only credentials for one authorized GHIN test account. Never expose
# these through NEXT_PUBLIC_, client storage, logs, screenshots or API errors.
GHIN_TEST_LOGIN=
GHIN_TEST_PASSWORD=
# Optional allowlisted host override. Defaults to https://api.ghin.com/api/v1.
GHIN_API_BASE_URL=
# Optional request field used by the documented golfer_login flow. The POC
# defaults to the historical non-secret sentinel "123" and does not copy any
# Firebase/API key from third-party source code.
GHIN_LOGIN_BOOTSTRAP_TOKEN=

# Group invitations: dedicated transactional email credential, server-only.
# Configure only Preview / phase2/full-platform; never reuse Auth SMTP secrets.
GROUP_INVITES_RESEND_API_KEY=
GROUP_INVITES_FROM_EMAIL=
# Optional stable invitation origin; otherwise Vercel's Preview branch alias.
GROUP_INVITES_APP_URL=

# Disaster recovery and automated offsite backups. Secrets stay empty here.
BACKUP_SOURCE=
BACKUP_EXPECTED_REF=
BACKUP_PGHOST=
BACKUP_PGPORT=
BACKUP_PGUSER=
BACKUP_PGDATABASE=
BACKUP_PGSSLROOTCERT=
BACKUP_STORAGE_URL=
BACKUP_PGPASSWORD=
BACKUP_STORAGE_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_ROOT=
BACKUP_DECRYPT_ACK=
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_BACKUP_ROOT_FOLDER_ID=
BACKUP_RETENTION_APPLY=false
