# The Backyard Account + Polla Live (Supabase). La app funciona como invitado sin estas variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alias moderno opcional; no es necesario cambiar las variables legacy actuales.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Nunca usar NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Feature flags de servidor. Vacío = habilitado cuando existe configuración.
CLOUD_ENABLED=
POLLA_LIVE_ENABLED=
AUTH_SOCIAL_ENABLED=

# Reglas con IA. La evidencia se recupera del índice local; OpenAI es el proveedor predeterminado.
RULES_AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_RULES_MODEL=
RULES_AI_ENABLED=

# Proveedor opcional: RULES_AI_PROVIDER=gemini. El vector store se conserva solo para el script legacy de indexado.
OPENAI_API_KEY=
OPENAI_RULES_VECTOR_STORE_ID=
OPENAI_RULES_MODEL=

# Disaster recovery and automated offsite backups. Secrets stay empty here.
BACKUP_SOURCE=
BACKUP_EXPECTED_REF=
BACKUP_PGHOST=
BACKUP_PGPORT=
BACKUP_PGUSER=
BACKUP_PGDATABASE=
BACKUP_PGSSLROOTCERT=
BACKUP_STORAGE_URL=
BACKUP_PGPASSWORD=
BACKUP_STORAGE_KEY=
BACKUP_ENCRYPTION_KEY=
BACKUP_ROOT=
BACKUP_DECRYPT_ACK=
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_BACKUP_ROOT_FOLDER_ID=
BACKUP_RETENTION_APPLY=false
