{
  "name": "golf-bets-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js && node --test scripts/backup/*.test.mjs scripts/run-preview-rls-tests.test.mjs scripts/canonical-preview-request.test.mjs scripts/qa-preview-public.test.mjs scripts/audit-static-assets.test.mjs",
    "test:stats:db": "node scripts/test-statistics-reset-db.mjs",
    "test:account:db": "node scripts/test-account-lifecycle-db.mjs",
    "test:social:db": "node scripts/test-social-activity-db.mjs",
    "qa:preview:stats": "node scripts/qa-preview-statistics.mjs",
    "qa:preview:account": "node scripts/qa-preview-account-lifecycle.mjs",
    "test:rls:preview": "node scripts/run-preview-rls-tests.mjs",
    "test:rls-runner": "node --test scripts/run-preview-rls-tests.test.mjs",
    "test:preview-request": "node --test scripts/canonical-preview-request.test.mjs",
    "test:backup": "node --test scripts/backup/backup.test.mjs",
    "test:recovery": "node --test --test-name-pattern=\"manifest|verifier|decrypt|bundle|SQL and custom archive\" scripts/backup/backup.test.mjs",
    "test:automation": "node --test scripts/backup/automation.test.mjs",
    "audit:assets": "node scripts/audit-static-assets.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "backup": "node scripts/backup/backup.mjs",
    "backup:source": "node scripts/backup/backup.mjs --only=source",
    "backup:schema": "node scripts/backup/backup.mjs --only=schema",
    "backup:database": "node scripts/backup/backup.mjs --only=database",
    "backup:storage": "node scripts/backup/backup.mjs --only=storage",
    "backup:verify": "node scripts/backup/verify-backup.mjs",
    "backup:security": "node scripts/backup/security-scan.mjs",
    "backup:automated": "node scripts/backup/automated-backup.mjs",
    "lint": "eslint .",
    "pwa:icons": "node scripts/build-pwa-icons.mjs",
    "rules:pdf-index": "node scripts/build-rules-search-index.mjs",
    "rules:index": "node --env-file=.env.local scripts/index-rules-pdf.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "emoji-regex": "10.6.0",
    "jspdf": "^3.0.3",
    "jsqr": "1.4.0",
    "next": "^16.0.0",
    "openai": "^7.8.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.12",
    "@napi-rs/canvas": "1.0.8",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@types/node": "22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.0.0",
    "tesseract.js": "7.0.0",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js",
      "tesseract.js",
      "unrs-resolver"
    ]
  }
}
