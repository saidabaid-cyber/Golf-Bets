# Server-only, private local operator configuration. Never NEXT_PUBLIC_.
GOLFAPI_API_KEY=
# Absolute persistent operator folder. A Vercel filesystem is NOT sufficient.
GOLFAPI_STORE_PATH=
# OFF except an explicit, budgeted operator command. Builds/CI are always OFF.
GOLFAPI_NETWORK_ENABLED=false
# Optional private reviewed mapping and read-only existing-card evidence for
# scripts/golfapi-reconcile.mjs (offline; never writes Course Master).
GOLFAPI_MAPPING_PATH=
GOLFAPI_EXISTING_CARDS_PATH=
